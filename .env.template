# Local Postgres (default — matches docker-compose.yml)
DATABASE_URL=postgresql://superset:superset@localhost:5432/finsight_dev

# Optional: only needed for the NP2SQL natural-language-query endpoint.
# Everything else (extraction, validation, API, Streamlit) runs without it.
# Set ONE of these — GROQ is preferred (OpenAI-compatible, free tier):
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
# Optional model override (defaults: llama-3.3-70b-versatile for Groq, gpt-4o-mini for OpenAI):
# NP2SQL_MODEL=

# Optional: only needed if you want SEC-API.io gap-filling instead of
# relying purely on the XBRL extraction.
# SEC_API_KEY=
